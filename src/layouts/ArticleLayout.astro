---
import BaseLayout from "#/layouts/BaseLayout.astro";

import { CONSTS } from "#/consts";

interface Props {
  title: string;
  description: string;
  publishedTime?: Date;
  image?: { src: ImageMetadata; alt: string };
}

const { title, ...props } = Astro.props;
---

<BaseLayout title={title} type="article" {...props}>
  <slot name="before" />
  <article>
    <h1>{title}</h1>
    <div class="dotted meta">
      <a href="/"><span>{CONSTS.title}</span></a>
      <span aria-hidden="true">&centerdot;</span>
      <slot name="meta" />
    </div>
    <slot name="intro" />
    <div class="prose">
      <slot />
    </div>
  </article>
  <dialog class="zoom" aria-label="Zoomed image">
    <img alt="" />
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("dialog.zoom");
  const zoomed = dialog?.querySelector("img");

  if (dialog && zoomed) {
    for (const image of document.querySelectorAll<HTMLImageElement>(".prose img")) {
      image.addEventListener("click", () => {
        zoomed.src = image.currentSrc;
        zoomed.alt = image.alt;
        dialog.showModal();
      });
    }

    dialog.addEventListener("click", () => dialog.close());
  }
</script>

<style>
  h1 {
    margin-bottom: 0.75rem;
  }

  .meta {
    margin-bottom: 1.25rem;
    color: var(--nav);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  a {
    text-decoration: none;
  }

  /* Morphs from and into the title of the home page */
  a span {
    view-transition-name: name;
  }

  /* The images come from the Markdown content, out of this component's scope */
  .prose :global(img) {
    cursor: zoom-in;
  }

  .zoom {
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 0;
    /* The dialog takes the focus when it opens, the outline would frame the image */
    outline: none;
    background: none;
    cursor: zoom-out;

    &::backdrop {
      background-color: color-mix(in oklab, var(--bg) 90%, transparent);
    }

    & img {
      max-width: 95vw;
      max-height: 95svh;
      object-fit: contain;
      border-radius: 0.375rem;
    }
  }
</style>
