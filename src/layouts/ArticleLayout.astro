---
import BaseLayout from "#/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  publishedTime?: Date;
  image?: { src: ImageMetadata; alt: string };
}

const { title, ...props } = Astro.props;
---

<BaseLayout title={title} type="article" {...props}>
  <div class="reading-progress" aria-hidden="true"></div>
  <article>
    <h1>{title}</h1>
    <div class="dotted meta">
      <slot name="meta" />
    </div>
    <slot name="intro" />
    <div class="prose">
      <slot />
    </div>
  </article>
  <dialog class="zoom" aria-label="Zoomed image">
    <p aria-hidden="true"></p>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("dialog.zoom");
  const caption = dialog?.querySelector("p");

  if (dialog && caption) {
    const zoomed = new Image();
    caption.before(zoomed);

    for (const image of document.querySelectorAll<HTMLImageElement>(".prose img:not(a img)")) {
      image.addEventListener("click", () => {
        zoomed.onload = zoomed.onerror = () => dialog.showModal();
        zoomed.src = image.srcset.split(",").at(-1)?.trim().split(" ")[0] || image.currentSrc;
        zoomed.alt = image.alt;
        caption.textContent = image.closest("figure")?.querySelector("figcaption")?.textContent ?? "";
      });
    }

    dialog.addEventListener("click", () => dialog.close());
  }
</script>

<style>
  .reading-progress {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 10;
    display: none;
    height: 2.5px;
    background-color: var(--nav);

    @supports (animation-timeline: scroll()) {
      display: block;
      transform-origin: left;
      animation: reading-progress linear both;
      animation-timeline: scroll(root);
    }
  }

  @keyframes reading-progress {
    from {
      transform: scaleX(0);
    }
  }

  h1 {
    margin-bottom: 0.75rem;
  }

  .meta {
    margin-bottom: 1.25rem;
    color: var(--nav);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .prose :global(img:not(a img)) {
    cursor: zoom-in;
  }

  .zoom {
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 0;
    outline: none;
    background: none;
    cursor: zoom-out;

    &::backdrop {
      background-color: color-mix(in oklab, var(--bg) 90%, transparent);
    }

    & :global(img) {
      max-width: 95vw;
      max-height: 85svh;
      object-fit: contain;
      border-radius: 0.375rem;
    }

    & p {
      width: 0;
      min-width: 100%;
      margin-top: 0.75rem;
      color: var(--nav);
      font-family: var(--font-sans);
      font-size: 0.875rem;
      line-height: 1.25rem;
      text-align: center;
      text-wrap: pretty;

      &:empty {
        display: none;
      }
    }
  }
</style>
