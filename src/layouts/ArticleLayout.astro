---
import BaseLayout from "#/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  publishedTime?: Date;
  image?: { src: ImageMetadata; alt: string };
}

const { title, ...props } = Astro.props;
---

<BaseLayout title={title} type="article" {...props}>
  <slot name="before" />
  <article>
    <h1>{title}</h1>
    <div class="dotted meta">
      <slot name="meta" />
    </div>
    <slot name="intro" />
    <div class="prose">
      <slot />
    </div>
  </article>
  <dialog class="zoom" aria-label="Zoomed image">
    <img alt="" />
    <p aria-hidden="true"></p>
  </dialog>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("dialog.zoom");
  const zoomed = dialog?.querySelector("img");
  const caption = dialog?.querySelector("p");

  if (dialog && zoomed && caption) {
    let current: HTMLImageElement | undefined;

    for (const image of document.querySelectorAll<HTMLImageElement>(".prose img")) {
      image.addEventListener("click", () => {
        current = image;
        zoomed.src = image.currentSrc;
        zoomed.alt = image.alt;
        caption.textContent = image.closest("figure")?.querySelector("figcaption")?.textContent ?? "";
        dialog.showModal();
      });
    }

    const close = () => {
      const image = current;
      dialog.close();
    };

    dialog.addEventListener("click", close);
    dialog.addEventListener("cancel", (event) => {
      event.preventDefault();
      close();
    });
  }
</script>

<style>
  h1 {
    margin-bottom: 0.75rem;
  }

  .meta {
    margin-bottom: 1.25rem;
    color: var(--nav);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .prose :global(img) {
    cursor: zoom-in;
  }

  .zoom {
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 0;
    outline: none;
    background: none;
    cursor: zoom-out;

    &::backdrop {
      background-color: color-mix(in oklab, var(--bg) 90%, transparent);
    }

    & img {
      max-width: 95vw;
      max-height: 85svh;
      object-fit: contain;
      border-radius: 0.375rem;
    }

    & p {
      width: 0;
      min-width: 100%;
      margin-top: 0.75rem;
      color: var(--nav);
      font-family: var(--font-sans);
      font-size: 0.875rem;
      line-height: 1.25rem;
      text-align: center;
      text-wrap: pretty;

      &:empty {
        display: none;
      }
    }
  }
</style>
