---
import BaseHead, {
  type Props as BaseHeadProps,
} from "#/layouts/BaseHead.astro";

import SideImage, {
  type Props as SideImageProps,
} from "#/components/SideImage.astro";

type Props = BaseHeadProps & {
  image?: SideImageProps;
};

const { image, ...head } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...head} image={image?.src} />
    <slot name="head" />
  </head>
  <body class="antialiased">
    <main class="max-w-8xl mx-auto px-5 py-10 sm:p-12 lg:grid lg:grid-cols-5 lg:items-start lg:gap-12 lg:pb-0">
      <div class="mx-auto max-w-xl lg:col-span-3 lg:mx-0 lg:pb-12">
        <slot />
      </div>
      <aside class="hidden lg:sticky lg:top-0 lg:col-span-2 lg:-mt-12 lg:block lg:h-svh lg:py-12">
        <SideImage {...image} />
      </aside>
    </main>
  </body>
</html>
