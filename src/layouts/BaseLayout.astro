---
import BaseHead, {
  type Props as BaseHeadProps,
} from "#/components/BaseHead.astro";

import SideImage, {
  type Props as SideImageProps,
} from "#/components/SideImage.astro";

import { CONSTS } from "#/consts";

type Props = Omit<BaseHeadProps, "image"> & {
  image?: SideImageProps;
};

const { image, ...head } = Astro.props;

const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...head} image={image?.src} />
    <slot name="head" />
  </head>
  <body>
    <main>
      <div class="content">
        <header>
          {isHome ? <h1 class="name">{CONSTS.title}</h1> : <a href="/" class="name">{CONSTS.title}</a>}
        </header>
        <slot />
      </div>
      <aside>
        <SideImage {...image} />
      </aside>
    </main>
  </body>
</html>

<style>
  main {
    max-width: 96rem;
    margin-inline: auto;
    padding: 2.5rem 1.25rem;

    @media (width >= 40rem) {
      padding: 3rem;
    }

    @media (width >= 64rem) {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      align-items: flex-start;
      gap: 3rem;
      padding-bottom: 0;
    }
  }

  .content {
    max-width: 36rem;
    margin-inline: auto;

    @media (width >= 64rem) {
      grid-column: span 3;
      margin-inline: 0;
      padding-bottom: 3rem;
    }
  }

  header {
    margin-bottom: 1rem;
  }

  .name {
    view-transition-name: name;
  }

  :global(:root[data-name-hidden]) .name {
    view-transition-name: none;
  }

  h1 {
    font-size: 1.875rem;
    line-height: 2.25rem;
  }

  a {
    display: block;
    width: fit-content;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.25rem;
    text-decoration: none;
  }

  aside {
    display: none;

    @media (width >= 64rem) {
      position: sticky;
      top: 0;
      display: block;
      grid-column: span 2;
      height: 100svh;
      margin-top: -3rem;
      padding-block: 3rem;
    }
  }
</style>
