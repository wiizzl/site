---
interface Props {
  title: string;
}

const { title } = Astro.props;
const id = `${title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}heading`;
---

<section class="mt-16" aria-labelledby={id}>
  <h2 id={id} class="text-heading mb-4 text-xl font-semibold tracking-tight text-balance">{title}</h2>
  <slot />
</section>
