---
import { CONSTS } from "#/consts";

interface Props {
  title: string;
  description: string;
  publishedTime?: Date;
}

const { title, description, publishedTime } = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site);
const author = { "@type": "Person", name: CONSTS.title, url: Astro.site };

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: CONSTS.title, item: Astro.site },
      { "@type": "ListItem", position: 2, name: title, item: url },
    ],
  },
  publishedTime && {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    datePublished: publishedTime.toISOString(),
    inLanguage: "en",
    author,
    publisher: author,
  },
].filter(Boolean);
---

{schemas.map((schema) => <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />)}
