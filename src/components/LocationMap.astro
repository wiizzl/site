---
interface Props {
  url: string;
}

const { url } = Astro.props;
---

<iframe title="OpenStreetMap" src={url} loading="lazy" referrerpolicy="no-referrer"></iframe>

<style>
  iframe {
    display: block;
    width: 100%;
    height: 14rem;
    margin-bottom: 1.5rem;
    border: 1px solid var(--line);
    border-radius: 0.375rem;
  }
</style>
