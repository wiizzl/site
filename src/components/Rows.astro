---
export interface Row {
  name: string;
  url: string;
  meta?: string;
  datetime?: string;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

<div class="rows">
  {rows.map((row) => (
    <a href={row.url}>
      <span>{row.name}</span>
      {row.datetime ? (
        <time class="meta" datetime={row.datetime}>{row.meta}</time>
      ) : row.meta && (
        <span class="meta">{row.meta}</span>
      )}
    </a>
  ))}
</div>

<style>
  .rows {
    margin-bottom: 1.5rem;
    border-top: 1px solid var(--line);
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--copy);
    text-decoration: none;
    transition: opacity 0.3s var(--ease);

    @media (width >= 40rem) {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 1.25rem;
    }

    &:hover {
      color: var(--copy);
    }
  }

  @media (pointer: fine) and (hover: hover) {
    .rows:hover a:not(:hover) {
      opacity: 0.8;
    }
  }

  .meta {
    color: var(--nav);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
