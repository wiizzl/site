---
interface Props {
  caption: string;
}

const { caption } = Astro.props;
---

<figure class="demo">
  <div class="body">
    <slot />
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .demo {
    margin-bottom: 1.5rem;
  }

  .body {
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background-color: var(--surface);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--nav);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1rem;
    text-align: center;
    text-wrap: pretty;
  }

  /* The controls come from the demo inside, so they're styled here once for every demo */
  .body :global(:is(button, input[type="text"])) {
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 0.375rem;
    background-color: var(--bg);
    color: var(--copy);
    font: inherit;
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .body :global(button) {
    cursor: pointer;
    transition: color 0.3s var(--ease);

    &:hover {
      color: var(--secondary);
    }
  }

  .body :global(input[type="checkbox"]) {
    accent-color: var(--nav);
  }

  /* The article styles don't apply inside a demo */
  .body :global(code) {
    padding: 0;
    color: inherit;
    font-size: 0.75rem;
  }

  .body :global(:is(ul, ol)) {
    margin: 0;
    list-style: none;

    & > * {
      margin-bottom: 0;
    }
  }
</style>
