---
import { Image } from "astro:assets";

import competing from "#/assets/activities/competing.webp";
import speaking from "#/assets/activities/speaking.webp";
import working from "#/assets/activities/working.webp";

const activities = [
  {
    src: working,
    alt: "Me wearing headphones, focused on my screens.",
    caption: "Me working",
  },
  {
    src: speaking,
    alt: "Me speaking into a microphone during a panel discussion on stage.",
    caption: "Me speaking",
  },
  {
    src: competing,
    alt: "Me coding at my workstation during the WorldSkills France national finals.",
    caption: "Me competing",
  },
];
---

<div class="pictures">
  {
    activities.map((activity) => (
      <figure>
        <Image src={activity.src} alt={activity.alt} width={480} height={640} />
        <figcaption>
          <span>{activity.caption}</span>
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .pictures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;

    @media (width >= 40rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  figure {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.375rem;
  }

  figure :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  figcaption {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 0.75rem;
    color: var(--heading);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1rem;
    transition: background-color 0.3s var(--ease);
  }

  span {
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  @media (hover: hover) {
    figure:hover figcaption {
      background-color: color-mix(in oklab, var(--bg) 50%, transparent);
    }

    figure:hover span {
      opacity: 1;
    }
  }
</style>
