---
interface Props {
  ratio?: string;
}

const { ratio = "3 / 4" } = Astro.props;
---

<div class="row" style={`--ratio: ${ratio}`}>
  <slot />
</div>

<style>
  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .row > :global(figure) {
    max-width: none;
    margin-bottom: 0;

    & :global(img) {
      width: 100%;
      aspect-ratio: var(--ratio);
      object-fit: cover;
    }
  }
</style>
