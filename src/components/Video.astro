---
import { Image } from "astro:assets";

interface Props {
  href: string;
  poster: ImageMetadata;
  alt: string;
  caption: string;
}

const { href, poster, alt, caption } = Astro.props;
---

<figure>
  <a href={href} target="_blank" aria-label={`${alt} Watch the video.`}>
    <Image src={poster} alt={alt} widths={[576, 1152, 1920].filter((width) => width < poster.width).concat(poster.width)} sizes="(width >= 40rem) 36rem, 100vw" />
    <span class="play" aria-hidden="true"></span>
  </a>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  figure {
    margin-bottom: 1.5rem;
  }

  a {
    position: relative;
    display: block;
    border-radius: 0.375rem;
    overflow: hidden;
  }

  .play {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    background-color: color-mix(in oklab, var(--bg) 85%, transparent);
    translate: -50% -50%;
    transition: scale 0.3s var(--ease);

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      margin: auto;
      width: 1.125rem;
      height: 1.25rem;
      background-color: var(--copy);
      clip-path: polygon(0 0, 100% 50%, 0 100%);
      translate: 0.125rem 0;
    }
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--nav);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1rem;
    text-align: center;
    text-wrap: pretty;
  }
</style>
