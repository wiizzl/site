---
import { Image } from "astro:assets";

import grosHorloge from "#/assets/side/gros-horloge.webp";

export interface Props {
  src?: ImageMetadata;
  alt?: string;
}

const {
  src = grosHorloge,
  alt = "The Gros-Horloge, the astronomical clock in the old town of Rouen, France.",
} = Astro.props;
---

<Image
  src={src}
  alt={alt}
  width={1280}
  widths={[480, 960, 1280]}
  sizes="40vw"
  loading="eager"
  fetchpriority="high"
  draggable="false"
  class="side-image"
/>

<style>
  :global(.side-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    view-transition-name: side-image;

    @media (prefers-color-scheme: dark) {
      filter: brightness(90%);
    }
  }
</style>
