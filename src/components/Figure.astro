---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
---

<figure>
  <!-- The text column is at most 36rem wide: the browser picks the smallest file that stays sharp, 2x screens included. The original size is always there for the zoom -->
  <Image src={src} alt={alt} widths={[576, 1152, 1920].filter((width) => width < src.width).concat(src.width)} sizes="(width >= 40rem) 36rem, 100vw" />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  figure {
    margin-bottom: 1.5rem;
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--nav);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1rem;
    text-align: center;
    text-wrap: pretty;
  }
</style>
