---
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  small?: boolean;
}

const { src, alt, caption, small = false } = Astro.props;
---

<figure class:list={{ small }}>
  <Image src={src} alt={alt} widths={[...new Set([576, 1152, 1600].map((width) => Math.min(width, src.width)))]} quality={65} sizes={small ? "18rem" : "(width >= 40rem) 36rem, 100vw"} />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  figure {
    margin-bottom: 1.5rem;
  }

  .small {
    max-width: 18rem;
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--nav);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1rem;
    text-align: center;
    text-wrap: pretty;
  }
</style>
