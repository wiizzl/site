---
import BaseLayout from "#/layouts/BaseLayout.astro";

import PersonSchema from "#/components/PersonSchema.astro";
import Pictures from "#/components/Pictures.astro";
import Rows from "#/components/Rows.astro";
import Section from "#/components/Section.astro";

import { CONSTS } from "#/consts";
import { formatMonth, getPosts, getProjects } from "#/lib/content";

const projects = await getProjects();
const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <PersonSchema slot="head" />
  <h1 class="text-heading view-transition-author mb-6 text-3xl font-semibold tracking-tight text-balance">{CONSTS.title}</h1>
  <div class="space-y-6">
    <p>
      I'm an {CONSTS.role.toLowerCase()} working at <a href={CONSTS.company.url}>{CONSTS.company.name}</a> and a freelancer based in {CONSTS.location.city}, {CONSTS.location.country}.
    </p>
    <p>
      In 2025, I became French Vice-Champion in Web Technologies at <a href={CONSTS.award.url}>WorldSkills France</a>.
    </p>
    <p>
      {CONSTS.links.map((link, i) => (<Fragment>{i > 0 && <span aria-hidden="true">&centerdot;</span>}<a href={link.url} rel="me">{link.name}</a></Fragment>))}
    </p>
  </div>

  <Section title="Some projects">
    <Rows rows={projects.map((project) => ({ name: project.data.title, url: `/projects/${project.id}`, meta: project.data.description }))} />
    <p class="mt-4"><a href="https://github.com/wiizzl?tab=repositories">More on GitHub</a></p>
  </Section>

  {
    posts.length > 0 && (
      <Section title="Some articles">
        <Rows rows={posts.map((post) => ({ name: post.data.title, url: `/blog/${post.id}`, meta: formatMonth(post.data.date), datetime: post.data.date.toISOString() }))} />
        <p class="mt-4"><a href="/blog">All articles</a></p>
      </Section>
    )
  }

  <Section title="Some pictures">
    <Pictures />
  </Section>

  <Section title="Get in touch">
    <p><a href={`mailto:${CONSTS.mail}`}>{CONSTS.mail}</a></p>
  </Section>
</BaseLayout>
